[Unit]
Description=SING-POET Service
Documentation=https://karing.app/sing-poet
After=network.target nss-lookup.target
Wants=network.target
[Service]
Type=simple
ExecStart=/usr/local/bin/sing-poet run -c /etc/sing-poet/server.json -p /etc/sing-poet/panel.json
Restart=on-failure
RestartSec=30s
RestartPreventExitStatus=23
LimitNPROC=10000
LimitNOFILE=1000000
[Install]
WantedBy=multi-user.target
